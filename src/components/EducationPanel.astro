---
/**
 * EducationPanel — the academic record framed as a model card: the ML-world
 * artifact, used sincerely. Labelled spec fields instead of a paragraph of
 * prose, GPA promoted to one prominent readout (not a /4.0 gauge — that would
 * imply a precision the source data doesn't carry), coursework as a dense
 * mono chip grid. Every value comes straight from `src/data/profile.ts`;
 * nothing here is retyped or invented.
 */
import { education } from "../data/profile";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Parse "YYYY-MM" from integers only — never `new Date("YYYY-MM")`, which V8
// reads as UTC midnight and can print the previous day/month once formatted
// against a local timezone.
function formatYM(ym: string): string {
  const [year, month] = ym.split("-").map(Number);
  return `${MONTHS[month - 1]} ${year}`;
}

const cards = education.map((edu) => {
  // The GPA honor reads "GPA 3.90 / 4.0" — pull the two numbers out of that
  // exact string (never retyped) so it can stand alone as a prominent
  // readout. If the string ever stops matching, fall back to leaving it in
  // the plain honors list rather than silently dropping it.
  const gpaHonor = edu.honors.find((h) => /^gpa\b/i.test(h.trim()));
  const gpaMatch = gpaHonor?.match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
  const gpaScore = gpaMatch?.[1] ?? null;
  const gpaScale = gpaMatch?.[2] ?? null;
  const otherHonors = gpaScore ? edu.honors.filter((h) => h !== gpaHonor) : edu.honors;

  return {
    ...edu,
    startText: formatYM(edu.start),
    endText: formatYM(edu.end),
    gpaScore,
    gpaScale,
    otherHonors,
  };
});
---

<section aria-labelledby="education-heading">
  <h2 id="education-heading" class="text-title text-bright" data-reveal>
    Education
  </h2>

  {
    cards.map((edu) => (
      <div class="mt-6 rounded-md border border-rule bg-raised" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-5 py-3">
          <span class="font-mono text-micro uppercase tracking-widest text-faint">
            model_card // education
          </span>
          {edu.expected && (
            <span class="rounded-sm border border-dashed border-accent-dim px-1.5 py-0.5 font-mono text-micro uppercase tracking-wide text-accent">
              expected
            </span>
          )}
        </div>

        <dl class="grid grid-cols-1 gap-x-6 gap-y-4 px-5 py-4 font-mono text-small sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-micro uppercase tracking-wide text-faint">Institution</dt>
            <dd class="mt-1 text-bright">{edu.institution}</dd>
          </div>

          <div class="sm:col-span-2">
            <dt class="text-micro uppercase tracking-wide text-faint">Degree</dt>
            <dd class="mt-1 text-text">{edu.degree}</dd>
          </div>

          <div>
            <dt class="text-micro uppercase tracking-wide text-faint">Enrolled</dt>
            <dd class="mt-1 text-text">{edu.startText}</dd>
          </div>

          <div>
            <dt class="text-micro uppercase tracking-wide text-faint">Graduation</dt>
            <dd class="mt-1 text-text">
              {edu.endText}
              {edu.expected && <span class="text-muted"> (expected)</span>}
            </dd>
          </div>

          {edu.gpaScore && (
            <div class="sm:col-span-2">
              <dt class="text-micro uppercase tracking-wide text-faint">GPA</dt>
              <dd class="mt-1 flex items-baseline gap-1.5">
                <span class="text-title text-accent">{edu.gpaScore}</span>
                <span class="text-small text-faint">/ {edu.gpaScale}</span>
              </dd>
            </div>
          )}
        </dl>

        {edu.otherHonors.length > 0 && (
          <div class="border-t border-rule px-5 py-4">
            <span class="font-mono text-micro uppercase tracking-wide text-faint">Honors</span>
            <ul class="mt-2 flex flex-col gap-1.5" data-reveal-group>
              {edu.otherHonors.map((h) => (
                <li class="font-mono text-small text-text" data-reveal>
                  {h}
                </li>
              ))}
            </ul>
          </div>
        )}

        {edu.coursework.length > 0 && (
          <div class="border-t border-rule px-5 py-4">
            <span class="font-mono text-micro uppercase tracking-wide text-faint">Coursework</span>
            <div class="mt-2 flex flex-wrap gap-1.5" data-reveal-group>
              {edu.coursework.map((c) => (
                <span
                  class="rounded-sm border border-rule px-2 py-0.5 font-mono text-micro text-muted"
                  data-reveal
                >
                  {c}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    ))
  }
</section>
