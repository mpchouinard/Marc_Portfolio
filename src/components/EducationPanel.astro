---
/**
 * Education: the academic record as a ledger, not a card.
 *
 * The dates live in `Trajectory.astro` (education is the spine of that
 * chart), so this component deliberately does NOT repeat a timeline. It
 * carries the things the chart cannot: the standing, the honors, and the
 * actual coursework.
 *
 * Form: hairline rules and typographic contrast rather than a bordered box.
 * The GPA is set at display scale because it is the one number here that a
 * reader is actually looking for.
 *
 * Every value comes from `src/data/profile.ts`. Nothing is retyped.
 */
import { education } from "../data/profile";

/**
 * Pull the numerator/denominator out of the real honors string
 * ("GPA 3.90 / 4.0") instead of hardcoding it, so editing profile.ts is
 * enough to change the site. Falls back to rendering the honor verbatim
 * as a plain line if the shape ever changes.
 */
function extractGpa(honors: readonly string[]) {
  for (const h of honors) {
    const m = h.match(/GPA\s*([\d.]+)\s*\/\s*([\d.]+)/i);
    if (m) return { value: m[1], scale: m[2], source: h };
  }
  return null;
}
---

<section aria-labelledby="education-heading" data-reveal>
  <header class="mb-10 border-b border-rule pb-4">
    <h2 id="education-heading" class="font-mono text-micro uppercase tracking-[0.2em] text-faint">
      Education
    </h2>
  </header>

  {
    education.map((edu) => {
      const gpa = extractGpa(edu.honors);
      const otherHonors = edu.honors.filter((h) => !gpa || h !== gpa.source);

      return (
        <div data-reveal-group>
          {/* Standing: the degree reads as the headline, the GPA as the
              single number worth setting large. */}
          <div
            class="flex flex-col gap-8 border-b border-rule pb-10 sm:flex-row sm:items-end sm:justify-between"
            data-reveal
          >
            <div>
              <p class="font-mono text-micro uppercase tracking-[0.2em] text-faint">
                {edu.institution}
              </p>
              <p class="mt-2 max-w-[28ch] font-mono text-title leading-tight text-bright">
                {edu.degree}
              </p>
            </div>

            {gpa && (
              <div class="flex items-end gap-6">
                <div>
                  <p class="font-mono text-micro uppercase tracking-[0.2em] text-faint">GPA</p>
                  <p class="font-mono text-display leading-none text-accent">
                    {gpa.value}
                    <span class="text-lede text-faint"> / {gpa.scale}</span>
                  </p>
                </div>
              </div>
            )}
          </div>

          {/* Honors: hairline rows, no chips, no boxes. */}
          {otherHonors.length > 0 && (
            <ul class="border-b border-rule" data-reveal>
              {otherHonors.map((h) => (
                <li class="flex items-baseline gap-4 border-t border-rule/50 py-3 first:border-t-0">
                  <span class="font-mono text-micro uppercase tracking-widest text-faint">
                    honor
                  </span>
                  <span class="font-mono text-small text-text">{h}</span>
                </li>
              ))}
            </ul>
          )}

          {/* Coursework: a dense ruled index, numbered so it reads as a
              record rather than a tag cloud. */}
          {edu.coursework.length > 0 && (
            <div class="pt-8" data-reveal>
              <p class="mb-4 font-mono text-micro uppercase tracking-[0.2em] text-faint">
                Coursework
                <span class="ml-2 text-faint/70">{edu.coursework.length}</span>
              </p>
              <ol class="grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
                {edu.coursework.map((course, i) => (
                  <li class="flex items-baseline gap-3 border-t border-rule/50 py-2.5 font-mono text-small">
                    <span class="tabular-nums text-micro text-faint">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="text-text">{course}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      );
    })
  }
</section>
