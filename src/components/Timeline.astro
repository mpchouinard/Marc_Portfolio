---
/**
 * Timeline: every `work` entry on one chronological spine, kinds interleaved.
 * This is "the container made visible": research, coursework, personal and
 * industry work share one line rather than sitting in three disconnected
 * lists.
 *
 * Presentation is a STICKY STACK. Each entry is `position: sticky` at a top
 * offset a little lower than the one before it, so scrolling deals the
 * projects into a pile: the card you are reading holds the viewport while the
 * next one slides up over it, and the ones already read stay visible as a row
 * of stacked edges above. The offsets are what make the pile legible; without
 * the per-item step every card would land in exactly the same place and the
 * stack would read as a single card that keeps changing.
 *
 * Why this and not the old flat list: /work is where someone decides whether
 * to click into a case study, and the flat version showed no cover art at all,
 * so every project looked identical. The stack gives each entry a full card
 * with its real image and enough room to be judged.
 *
 * Kinds are still told apart by weight / case / border treatment only: the
 * palette has exactly one accent colour (PLAN.md section 6), reserved for the
 * "ongoing" marker rather than for telling kinds apart.
 *
 * Accessibility and no-JS: this is an ordered list of links, fully rendered
 * server-side. Sticky is pure CSS, so the stack works with JS disabled. No
 * `data-reveal` on the sticky items on purpose: the reveal engine animates
 * `transform`, and a transform on a sticky element makes it a containing
 * block, which fights the stacking. The section heading above it still
 * reveals normally.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ProjectArt from "./ProjectArt.astro";

interface Props {
  entries: CollectionEntry<"work">[];
}

const { entries } = Astro.props;

// Oldest to newest: the timeline reads as a trajectory, ending at "ongoing".
const sorted = [...entries].sort(
  (a, b) => a.data.period.start.valueOf() - b.data.period.start.valueOf(),
);

function formatMonthYear(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
}

type Kind = CollectionEntry<"work">["data"]["kind"];

// Four kinds, one accent colour: differentiated by weight, case and border
// treatment rather than by inventing new hues.
const KIND_META: Record<Kind, { label: string; class: string }> = {
  research: { label: "Research", class: "font-bold uppercase tracking-widest text-text" },
  industry: {
    label: "Industry",
    class: "border border-rule px-1.5 py-0.5 font-bold uppercase tracking-widest text-text",
  },
  coursework: {
    label: "Coursework",
    class: "border border-dashed border-rule px-1.5 py-0.5 font-normal uppercase tracking-wide",
  },
  personal: { label: "personal", class: "font-normal lowercase" },
};
---

{
  sorted.length > 0 && (
    <ol class="project-stack">
      {sorted.map((entry, i) => {
        const d = entry.data;
        const ongoing = !d.period.end;
        const meta = KIND_META[d.kind];
        const chips = [...d.domains.slice(0, 3), ...d.methods.slice(0, 2)];
        return (
          <li class="project-stack__item" style={`--i:${i}`}>
            <a
              href={`/work/${entry.id}/`}
              class="project-card group block border border-rule bg-raised p-5 transition-colors duration-200 ease-out-expo hover:border-accent-dim focus-visible:border-accent md:p-7"
            >
              <div class="grid gap-5 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-7">
                <div class="project-card__media relative overflow-hidden border border-rule">
                  {d.cover ? (
                    <Image
                      src={d.cover}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 20rem, 92vw"
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-settle group-hover:scale-[1.03]"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <ProjectArt
                      id={entry.id}
                      domains={d.domains}
                      methods={d.methods}
                      stack={d.stack}
                      class="aspect-[16/9] w-full transition-transform duration-500 ease-settle group-hover:scale-[1.03]"
                    />
                  )}
                </div>

                <div class="flex min-w-0 flex-col">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-micro text-muted">
                    <span aria-hidden="true" class="text-faint">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class={meta.class}>{meta.label}</span>
                    <time>
                      {formatMonthYear(d.period.start)}
                      {" – "}
                      {ongoing ? (
                        <span class="font-bold text-accent">ongoing</span>
                      ) : (
                        formatMonthYear(d.period.end as Date)
                      )}
                    </time>
                    {ongoing && <span aria-hidden="true" class="ongoing-pulse" />}
                  </div>

                  <h3 class="mt-2 break-words text-title transition-colors duration-200 ease-out-expo group-hover:text-accent">
                    {d.title}
                  </h3>

                  <p class="mt-2 max-w-prose break-words text-small text-text">{d.summary}</p>

                  {chips.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {chips.map((tag) => (
                        <li class="border border-rule px-2 py-0.5 font-mono text-micro text-muted">
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )}

                  <span
                    aria-hidden="true"
                    class="mt-auto pt-5 font-mono text-micro uppercase tracking-[0.2em] text-faint transition-colors duration-200 ease-out-expo group-hover:text-accent"
                  >
                    Read case study →
                  </span>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  )
}

<style>
  /*
    --stack-top clears the fixed nav so a stuck card never hides under it.
    --stack-step is how far each successive card is offset, which is what
    leaves a visible edge of every previously-read card above the current one.
    With seven entries the deepest card sits 6 steps down, so the whole pile
    stays well inside the viewport.
  */
  .project-stack {
    --stack-top: 5rem;
    --stack-step: 0.6rem;
    /* Deliberately a plain block flow rather than flex with `gap`. A flex
       container makes each card a flex item whose containing block is the
       flex box, which is a sharper edge case for sticky than normal flow and
       buys nothing here. Spacing comes from margin instead. */
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-stack__item {
    position: sticky;
    top: calc(var(--stack-top) + (var(--i) * var(--stack-step)));
  }

  .project-stack__item + .project-stack__item {
    margin-top: 1.25rem;
  }

  /*
    The card must be fully opaque. A translucent card would let the previous
    card in the pile show through it, which reads as a rendering bug rather
    than as depth. bg-raised on the anchor supplies the fill; this adds the
    cast shadow that separates one card from the one it is covering.
  */
  .project-card {
    box-shadow: 0 -1px 0 0 var(--color-rule), 0 -18px 40px -24px rgb(0 0 0 / 0.9);
  }

  .project-card__media {
    background-color: var(--color-sunken);
  }

  /*
    Scroll-driven entrance for each card.

    These items deliberately do not use `data-reveal` (a transform on a sticky
    element makes it a containing block and breaks the stacking), so the
    entrance is done with a scroll-driven timeline on the INNER card instead,
    leaving the sticky <li> itself untransformed.

    The range is `entry`, which is the window before the card reaches its stuck
    position. That matters for sticky elements: once pinned, an element's box
    stops moving through the scrollport and `view()` progress would sit still,
    so any range overlapping the pinned phase would simply freeze mid-animation.
    Animating only during entry avoids that entirely.

    Gated on both @supports and js-reveal, so browsers without scroll-driven
    animations and reduced-motion readers get the finished card immediately.
  */
  @supports (animation-timeline: view()) {
    :global(html.js-reveal) .project-card {
      animation: card-enter linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 85%;
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /*
    The only looping animation on the page, deliberately. It marks live work,
    which is the one thing on a portfolio that is genuinely still changing, so
    it earns a heartbeat. Cost is bounded by construction: it is transform and
    opacity on a 6px pseudo-element, and only entries with no end date have
    one, currently three.
  */
  .ongoing-pulse {
    position: relative;
    display: inline-block;
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-accent);
  }

  .ongoing-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-accent);
    animation: ongoing-ping 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes ongoing-ping {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ongoing-pulse::after {
      animation: none;
    }
  }

  /*
    Reduced motion: keep the stack, drop the scroll-coupled behaviour. Sticky
    itself is not an animation, but a pile that reassembles under the reader
    is motion they did not ask for, so the cards simply flow normally. The
    hover scale on the cover is also removed rather than shortened.
  */
  @media (prefers-reduced-motion: reduce) {
    .project-stack__item {
      position: static;
    }
    .project-card__media :global(img),
    .project-card__media :global(svg) {
      transition: none;
      transform: none !important;
    }
  }
</style>
