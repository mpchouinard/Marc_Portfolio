---
/**
 * ExperienceRuns — the four roles as horizontal duration bars on one shared
 * time axis, instead of another vertical bulleted list. The point a list
 * hides and this makes visible: the roles overlap — Outlier ran underneath
 * everything else for three years, AMC and Code Ninjas overlapped through
 * 2025, and research started in 2026 while Code Ninjas was still running.
 *
 * All geometry is derived from the real "YYYY-MM" strings in
 * `src/data/profile.ts`, parsed as plain year/month integers — never as
 * `new Date("YYYY-MM")`, which V8 reads as UTC midnight and can drift a
 * day/month once formatted against a local timezone. `end: null` (ongoing)
 * is never treated as "ends today" visually — it gets a distinct fading/
 * dashed terminal edge plus an explicit "ongoing" label, both in the chart
 * and in its text range, so screen-reader users get the same information a
 * sighted reader gets from the bar shape.
 *
 * Below `md` a horizontal bar chart is the failure case on narrow screens
 * (bars compress to illegibility), so it's replaced outright by a stacked
 * list that still states each range as plain text.
 */
import { experience } from "../data/profile";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

type YM = { year: number; month: number };

function parseYM(s: string): YM {
  const [year, month] = s.split("-").map(Number);
  return { year, month };
}

function formatYM(ym: YM): string {
  return `${MONTHS[ym.month - 1]} ${ym.year}`;
}

// Absolute month count — a plain integer axis, so every bar position is
// integer arithmetic and never touches Date/timezone machinery.
function toIndex(ym: YM): number {
  return ym.year * 12 + (ym.month - 1);
}

// "Today" only needs year/month precision, so the no-argument `new Date()`
// (local wall-clock time) is safe here — the timezone-drift hazard above is
// specific to parsing a partial-date *string*, not reading the current date.
const now = new Date();
const todayIndex = toIndex({ year: now.getFullYear(), month: now.getMonth() + 1 });

const parsed = experience.map((role) => {
  const startYM = parseYM(role.start);
  const startIndex = toIndex(startYM);
  const ongoing = role.end === null;
  const endIndex = role.end ? toIndex(parseYM(role.end)) : todayIndex;
  const rangeText = `${formatYM(startYM)} – ${role.end ? formatYM(parseYM(role.end)) : "Present"}`;

  return {
    ...role,
    startIndex,
    endIndex,
    ongoing,
    rangeText,
    // The Code Ninjas placeholder bullet must never render — filtered
    // generically so it's caught regardless of which role it ends up on.
    bullets: role.bullets.filter((b) => !b.includes("TODO(")),
  };
});

// A month of padding on each edge so no bar ever touches the container wall.
const PAD = 1;
const axisStart = Math.min(...parsed.map((r) => r.startIndex)) - PAD;
const axisEnd = Math.max(todayIndex, ...parsed.map((r) => r.endIndex)) + PAD;
const axisSpan = axisEnd - axisStart;

const rows = parsed.map((r) => ({
  ...r,
  offsetPct: ((r.startIndex - axisStart) / axisSpan) * 100,
  widthPct: Math.max(((r.endIndex - r.startIndex) / axisSpan) * 100, 0.5),
}));

// Year gridlines: every January that actually falls within the padded axis.
const firstCandidate = Math.floor(axisStart / 12);
const lastCandidate = Math.ceil(axisEnd / 12);
const yearMarks: { year: number; pct: number }[] = [];
for (let y = firstCandidate; y <= lastCandidate; y++) {
  const idx = y * 12; // January of year y
  if (idx >= axisStart && idx <= axisEnd) {
    yearMarks.push({ year: y, pct: ((idx - axisStart) / axisSpan) * 100 });
  }
}
---

<section aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="text-title text-bright" data-reveal>
    Experience
  </h2>

  <!-- Desktop / tablet: horizontal duration bars on one shared time axis. -->
  <div class="mt-8 hidden md:block">
    <div class="relative h-3 border-b border-rule/70" aria-hidden="true">
      {
        yearMarks.map((y) => (
          <span class="absolute bottom-0 block h-2 w-px -translate-x-1/2 bg-rule" style={`left:${y.pct}%`} />
        ))
      }
    </div>
    <div class="relative mb-6 h-4" aria-hidden="true">
      {
        yearMarks.map((y) => (
          <span class="absolute -translate-x-1/2 font-mono text-micro text-faint" style={`left:${y.pct}%`}>
            {y.year}
          </span>
        ))
      }
    </div>

    <div data-reveal-group>
      {
        rows.map((row) => (
          <div class="border-t border-rule/40 py-5 first:border-t-0 first:pt-0" data-reveal>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-small">
              <span class="text-bright">{row.title}</span>
              <span class="text-muted">— {row.org}</span>
              <span class="text-micro text-faint">{row.rangeText}</span>
              {row.ongoing && (
                <span class="rounded-sm border border-dashed border-accent-dim px-1.5 py-0.5 font-mono text-micro uppercase tracking-wide text-accent">
                  ongoing
                </span>
              )}
            </div>

            <div class="relative mt-2 h-2.5 rounded-sm bg-sunken" aria-hidden="true">
              <div
                class:list={[
                  "absolute inset-y-0 rounded-sm",
                  row.ongoing ? "border-r border-dashed border-accent" : "bg-accent-dim/80",
                ]}
                style={`left:${row.offsetPct}%; width:${row.widthPct}%;${
                  row.ongoing
                    ? " background:linear-gradient(to right, var(--color-accent-dim) 0%, var(--color-accent) 55%, transparent 100%);"
                    : ""
                }`}
              />
            </div>

            {row.bullets.length > 0 && (
              <ul class="mt-3 flex flex-col gap-1 pl-4 text-small text-muted">
                {row.bullets.map((b) => (
                  <li class="list-disc marker:text-faint">{b}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile: a bar chart is the failure case on narrow screens, so fall
       back to a stacked list that still states each range as text. -->
  <div class="mt-8 flex flex-col gap-5 md:hidden" data-reveal-group>
    {
      rows.map((row) => (
        <div class="rounded-md border border-rule bg-raised p-4" data-reveal>
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-small">
            <span class="text-bright">{row.title}</span>
            <span class="text-muted">— {row.org}</span>
          </div>
          <div class="mt-1 font-mono text-micro text-faint">
            {row.rangeText}
            {row.ongoing && <span class="ml-2 uppercase tracking-wide text-accent">ongoing</span>}
          </div>
          {row.bullets.length > 0 && (
            <ul class="mt-3 flex flex-col gap-1 pl-4 text-small text-muted">
              {row.bullets.map((b) => (
                <li class="list-disc marker:text-faint">{b}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</section>
