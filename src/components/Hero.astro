---
/**
 * Hero: the site's signature moment.
 *
 * Structure:
 *  - `#hero` is a tall (200vh) section; its inner wrapper is `position:
 *    sticky; top: 0; height: 100vh`, a pure-CSS pin with none of GSAP's
 *    `pin: true` scroll-jack risk, it's native browser behavior, always
 *    interruptible, never traps the scroll.
 *  - The hero owns NO background element of its own. The glyph field is a
 *    single document-level canvas mounted in Base.astro and shared by every
 *    page; the hero only drives it. An earlier version crossfaded the field
 *    into a green aurora gradient here, which meant the hero carried its own
 *    background layer. Owner removed that on 2026-08-29: the scroll response
 *    is now a light blur on the field itself, so the maths stays on screen
 *    the whole way down instead of being replaced by a colour wash.
 *  - The extra 100vh of scroll the tall section provides is split: the
 *    ScrollTrigger-scrubbed intensity-and-blur pass completes over the first
 *    ~70% of it, leaving the last ~30% as a deliberate "rest" beat: the
 *    softened field sits still before the section finally releases and normal
 *    content scrolls up over it.
 *  - The name + tagline (z-10), plain server-rendered DOM, unconditionally
 *    visible: never gated on JS or animation state. This is what LCP
 *    measures; the canvas is decorative and sits behind it.
 *
 * Motion wiring (see `../scripts/motion.ts`):
 *  - `prefers-reduced-motion`: Lenis is never initialized and the
 *    ScrollTrigger scrub is never created. The field stays at its CSS
 *    resting state: full intensity, zero blur, rendering the single static
 *    frame `glyph-field.ts` draws on its own. That resting composition *is*
 *    the reduced-motion fallback: a static hero, no animation, nothing
 *    shortened.
 *  - Otherwise: Lenis smooth scroll starts, then a GSAP ScrollTrigger scrubs
 *    the field's intensity and blur across the hero's own viewport height.
 *  - Live toggling of the OS setting is handled: flip it mid-session and
 *    the hero switches between the two modes immediately.
 *
 * Owned by Wave 1 Agent C.
 */
import { profile } from "../data/profile";
---

<section id="hero" class="relative h-[200vh] w-full">
  <div class="sticky top-0 flex h-screen w-full flex-col items-center justify-center overflow-hidden">
    <div class="relative z-10 flex flex-col items-center px-6 text-center">
      {/* data-text feeds the two decorative layers in global.css. They are
          built from attr(data-text) rather than duplicated markup so the
          accessibility tree and the page text stay a single string. */}
      <h1 class="text-hero text-bright" data-text={profile.name}>
        {profile.name}
      </h1>
      <p class="mt-6 max-w-2xl text-lede text-muted">
        {profile.tagline}
      </p>
    </div>

    <div
      id="hero-scroll-cue"
      class="pointer-events-none absolute inset-x-0 bottom-8 z-10 flex flex-col items-center gap-3"
      aria-hidden="true"
    >
      <span class="text-micro font-mono uppercase tracking-[0.3em] text-muted">Scroll</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 animate-bounce text-faint"
      >
        <path d="M12 4v14m0 0-5-5m5 5 5-5" />
      </svg>
    </div>
  </div>
</section>

<style>
  /* The extra 100vh of section height exists purely to host the sticky
     "hold" range the scroll-scrubbed crossfade animates through. Under
     reduced motion that animation never runs (see the script below), so
     the extra scroll distance would just be dead space, collapse it back
     to a plain 100vh section instead of making reduced-motion users scroll
     through a static screen twice as tall as it needs to be. This is a
     pure CSS fallback: it applies before any JS runs. */
  @media (prefers-reduced-motion: reduce) {
    #hero {
      height: 100vh;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, initSmoothScroll, prefersReducedMotion, onReducedMotionChange } from "../scripts/motion";

  const heroSection = document.getElementById("hero");
  const fieldLayer = document.getElementById("glyph-field-layer");
  const scrollCue = document.getElementById("hero-scroll-cue");

  // How far out of focus the field goes by the end of the hero scrub. Kept
  // deliberately light: enough to push the field behind the content, not
  // enough to turn it into a smear. Blur is the only thing the hero does to
  // the background now.
  const MAX_FIELD_BLUR_PX = 6;

  if (heroSection && fieldLayer) {
    let cleanupSmoothScroll: () => void = () => {};
    let timeline: ReturnType<typeof gsap.timeline> | null = null;
    let trigger: ScrollTrigger | null = null;

    function enableMotion(): void {
      cleanupSmoothScroll = initSmoothScroll();

      // Built paused, then handed to ScrollTrigger as `animation` below:
      // ScrollTrigger drives its progress from scroll, so it must never
      // free-run on its own timeline default (autoplay).
      timeline = gsap.timeline({ paused: true });
      // The glyph field is now ONE document-level canvas (Base.astro), so
      // the hero scrubs its intensity instead of fading a local copy. It
      // never reaches 0: the field persists faintly down the whole page,
      // which is the point of the site-wide canvas.
      const fieldLevel = { value: 1 };
      timeline.to(
        fieldLevel,
        {
          value: 0.14,
          ease: "none",
          onUpdate: () => {
            (window as any).__glyphField?.setIntensity(fieldLevel.value);
          },
        },
        0,
      );

      // The field softens as the hero scrolls rather than being crossfaded
      // out behind a gradient. Driven through a custom property so the
      // filter string is rebuilt by CSS, not by GSAP parsing and
      // reserialising `filter` on every frame.
      const fieldBlur = { value: 0 };
      timeline.to(
        fieldBlur,
        {
          value: MAX_FIELD_BLUR_PX,
          ease: "none",
          onUpdate: () => {
            fieldLayer.style.setProperty("--glyph-blur", `${fieldBlur.value}px`);
          },
        },
        0,
      );
      // The cue fades out quickly (a fifth the duration of the main
      // crossfade), it has no reason to linger once the user is already
      // well into the 200vh hero journey.
      if (scrollCue) timeline.to(scrollCue, { opacity: 0, ease: "none", duration: 0.2 }, 0);

      trigger = ScrollTrigger.create({
        trigger: heroSection,
        start: "top top",
        // The section is 200vh (100vh visible + 100vh of sticky "hold"
        // room). The crossfade finishes 70% of the way through that extra
        // range, leaving a deliberate still beat on the softened field
        // before the section releases. A function re-evaluates on resize,
        // so this stays correct across viewport size changes.
        end: () => `+=${window.innerHeight * 0.7}`,
        scrub: 0.5,
        animation: timeline,
      });
    }

    function disableMotion(): void {
      trigger?.kill();
      trigger = null;
      timeline?.kill();
      timeline = null;
      cleanupSmoothScroll();
      cleanupSmoothScroll = () => {};
      // Resting state: glyph field owns the view, fully sharp. This is
      // exactly the pre-scroll composition of the animated version, held
      // still: the reduced-motion fallback, not a shortened animation.
      (window as any).__glyphField?.setIntensity(1);
      fieldLayer.style.setProperty("--glyph-blur", "0px");
      if (scrollCue) gsap.set(scrollCue, { opacity: 1 });
    }

    if (prefersReducedMotion()) {
      disableMotion();
    } else {
      enableMotion();
    }

    const unsubscribeReducedMotion = onReducedMotionChange((reduced) => {
      if (reduced) disableMotion();
      else enableMotion();
    });

    // Everything the hero drives is only worth paying for while the hero is
    // actually on screen: the compositor hint on the full-viewport field
    // layer, and the name's infinite gradient sweep. Both used to run for
    // the life of the page, repainting behind content nobody was looking at.
    // The attribute goes on the SECTION, not on one child, so a single flag
    // governs every looping animation the hero owns: the name's gradient sweep
    // and the scroll cue's bounce. Both are decorative and neither is worth a
    // repaint once nobody can see them.
    const heroVisibility = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        fieldLayer.classList.toggle("is-hero-active", visible);
        if (visible) heroSection.removeAttribute("data-offscreen");
        else heroSection.setAttribute("data-offscreen", "");
      },
      { rootMargin: "10% 0px" },
    );
    heroVisibility.observe(heroSection);

    const teardown = () => {
      disableMotion();
      heroVisibility.disconnect();
      fieldLayer.classList.remove("is-hero-active");
      unsubscribeReducedMotion();
      window.removeEventListener("astro:before-swap", teardown);
    };
    window.addEventListener("astro:before-swap", teardown, { once: true });
  }
</script>
