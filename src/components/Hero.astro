---
/**
 * Hero: the site's signature moment.
 *
 * Structure:
 *  - `#hero` is a tall (200vh) section; its inner wrapper is `position:
 *    sticky; top: 0; height: 100vh`, a pure-CSS pin with none of GSAP's
 *    `pin: true` scroll-jack risk, it's native browser behavior, always
 *    interruptible, never traps the scroll.
 *  - History: an earlier version said the hero "owns NO background element
 *    of its own" and only drove the document-level glyph field's intensity
 *    (1 to ~0.14) and blur. Owner decision 2026-09-16 reworks this: the hero
 *    now owns `#hero-fractal-layer`, a background layer BEHIND the name and
 *    tagline (z-0, under the text's z-10) holding `MandelbrotField.astro`, a
 *    canvas that draws a continuously zooming Mandelbrot dive through
 *    `glyph-kit.ts`'s shared alphabet, palette and bloom atlas, so it reads
 *    as the same signature material as the document field rather than a
 *    second effect. The layer's own background is the solid `bg-ground`
 *    colour, deliberately opaque: it guarantees the document glyph field
 *    never shows through the fractal while the hero is in view, no matter
 *    which of the two canvases finishes mounting first. The scroll scrub
 *    below is the crossfade handoff: as the fractal layer fades to
 *    transparent, the document field's intensity rises from 0 in lockstep,
 *    so the reader always sees exactly one glyph field at any given scroll
 *    position, never a flash of both or neither.
 *  - The extra 100vh of scroll the tall section provides is split: the
 *    ScrollTrigger-scrubbed crossfade-and-blur pass completes over the first
 *    ~70% of it, leaving the last ~30% as a deliberate "rest" beat: the
 *    softened field sits still before the section finally releases and normal
 *    content scrolls up over it.
 *  - The name + tagline (z-10), plain server-rendered DOM, unconditionally
 *    visible: never gated on JS or animation state. This is what LCP
 *    measures; both canvases are decorative and sit behind it. Owner decision
 *    2026-09-16 also shrank the name to about half the viewport width (see
 *    `--text-hero` in global.css) and added a soft halo behind name and
 *    tagline, a token-built radial gradient, so the now-smaller text stays
 *    legible over the brighter fractal glyphs.
 *
 * Motion wiring (see `../scripts/motion.ts`):
 *  - `prefers-reduced-motion`: Lenis is never initialized and the
 *    ScrollTrigger scrub is never created. The fractal layer stays fully
 *    opaque (the reduced-motion resting composition), the document field
 *    stays at its normal below-hero resting intensity (0.14) and blur (6px),
 *    matching what the scrub would have settled on. That resting composition
 *    *is* the reduced-motion fallback: a static hero, no animation, nothing
 *    shortened.
 *  - Otherwise: Lenis smooth scroll starts, then a GSAP ScrollTrigger scrubs
 *    the fractal layer's opacity, the document field's intensity and its
 *    blur across the hero's own viewport height.
 *  - Live toggling of the OS setting is handled: flip it mid-session and
 *    the hero switches between the two modes immediately.
 *
 * Owned by Wave 1 Agent C.
 */
import { profile } from "../data/profile";
import MandelbrotField from "./MandelbrotField.astro";
---

<section id="hero" class="relative h-[200vh] w-full">
  <div class="sticky top-0 flex h-screen w-full flex-col items-center justify-center overflow-hidden">
    <div id="hero-fractal-layer" class="absolute inset-0 z-0 bg-ground" aria-hidden="true">
      <MandelbrotField />
    </div>

    <div class="relative z-10 flex flex-col items-center px-6 text-center">
      <div class="hero-halo flex flex-col items-center px-6 py-12 md:px-10">
        {/* data-text feeds the two decorative layers in global.css. They are
            built from attr(data-text) rather than duplicated markup so the
            accessibility tree and the page text stay a single string. */}
        <h1 class="text-hero text-bright" data-text={profile.name}>
          {profile.name}
        </h1>
        <p class="mt-6 max-w-[min(36rem,85vw)] text-body text-text md:max-w-[min(36rem,50vw)]">
          {profile.tagline}
        </p>
      </div>
    </div>

    <div
      id="hero-scroll-cue"
      class="pointer-events-none absolute inset-x-0 bottom-8 z-10 flex flex-col items-center gap-3"
      aria-hidden="true"
    >
      <span class="text-micro font-mono uppercase tracking-[0.3em] text-muted">Scroll</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 animate-bounce text-faint"
      >
        <path d="M12 4v14m0 0-5-5m5 5 5-5" />
      </svg>
    </div>
  </div>
</section>

<style>
  /* The extra 100vh of section height exists purely to host the sticky
     "hold" range the scroll-scrubbed crossfade animates through. Under
     reduced motion that animation never runs (see the script below), so
     the extra scroll distance would just be dead space, collapse it back
     to a plain 100vh section instead of making reduced-motion users scroll
     through a static screen twice as tall as it needs to be. This is a
     pure CSS fallback: it applies before any JS runs. */
  @media (prefers-reduced-motion: reduce) {
    #hero {
      height: 100vh;
    }
  }

  /* Soft dark halo behind the name and tagline, built only from tokens. The
     smaller (owner decision 2026-09-16) hero name now sits over a bright,
     moving fractal instead of the calmer document field, so the text needs
     its own contrast floor rather than relying on the field's intensity
     being low.

     The gradient lives on a `::before` pseudo-element rather than directly
     on `.hero-halo`'s background, sized well past the text box (`inset:
     -45% -30%`) so the darkened region reads as an ambient halo instead of a
     box that clips at the padding edge. `closest-side` makes the ellipse
     fill that oversized box rather than shrinking to the text's own
     dimensions, which is what let the darkened area fade out before
     reaching the glyphs in the first pass. `z-index: -1` on the pseudo-
     element keeps it behind the name and tagline; `isolation: isolate` on
     `.hero-halo` gives that z-index a local stacking context so it cannot
     land behind the fractal layer by mistake. The h1's own bloom layers
     (global.css) create their own stacking context via `position: relative;
     isolation: isolate` on `#hero h1`, so they stay above this halo
     regardless of paint order. Pure CSS: no JS dependency, so it renders
     identically with JS disabled and under reduced motion. */
  .hero-halo {
    position: relative;
    isolation: isolate;
  }

  .hero-halo::before {
    content: "";
    position: absolute;
    inset: -45% -30%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--color-ground) 92%, transparent) 0%,
      color-mix(in oklab, var(--color-ground) 80%, transparent) 45%,
      transparent 100%
    );
  }
</style>

<script>
  import { gsap, ScrollTrigger, initSmoothScroll, prefersReducedMotion, onReducedMotionChange } from "../scripts/motion";
  import { getMandelbrotField } from "../scripts/mandelbrot-field";

  const heroSection = document.getElementById("hero");
  const fieldLayer = document.getElementById("glyph-field-layer");
  const fractalLayer = document.getElementById("hero-fractal-layer");
  const scrollCue = document.getElementById("hero-scroll-cue");

  // How far out of focus the document field goes by the end of the hero
  // scrub. Kept deliberately light: enough to push the field behind the
  // content, not enough to turn it into a smear.
  const MAX_FIELD_BLUR_PX = 6;
  // The document field's resting intensity below the hero, and the value
  // the crossfade scrubs up to as the fractal layer fades out.
  const RESTING_FIELD_INTENSITY = 0.14;

  if (heroSection && fieldLayer) {
    let cleanupSmoothScroll: () => void = () => {};
    let timeline: ReturnType<typeof gsap.timeline> | null = null;
    let trigger: ScrollTrigger | null = null;

    // The fractal canvas may mount before or after this script runs, so its
    // handle is looked up lazily and re-attempted on `mandelbrotfield:ready`.
    // `visible` and `fractalOpacity` are tracked independently, because
    // `setActive` must reflect BOTH the section's on-screen state and
    // whether the scrub has already faded the layer out: either one being
    // false is reason enough to pause the worker.
    let fractal: ReturnType<typeof getMandelbrotField> | undefined;
    let sectionVisible = false;
    let fractalOpacity = 1;

    function syncFractalActive(): void {
      fractal?.setActive(sectionVisible && fractalOpacity > 0.01);
    }

    function attachFractal(canvas: HTMLCanvasElement): void {
      fractal = getMandelbrotField(canvas);
      syncFractalActive();
    }

    const existingCanvas = fractalLayer?.querySelector<HTMLCanvasElement>("canvas[data-mandelbrot-field]");
    if (existingCanvas) attachFractal(existingCanvas);

    const onFractalReady = (event: Event) => {
      const canvas = (event as CustomEvent<{ canvas: HTMLCanvasElement }>).detail?.canvas;
      if (canvas) attachFractal(canvas);
    };
    if (!fractal) window.addEventListener("mandelbrotfield:ready", onFractalReady);

    // The document field starts this page at intensity 0: the opaque
    // fractal layer covers it completely until the scrub begins, so there
    // is nothing to gain (and a flash to lose) from letting it run at any
    // other level underneath. Applied both here and on `glyphfield:ready`,
    // in case the field mounts after this script does, and reads the
    // timeline's CURRENT value rather than hard-coding 0, since a reload
    // mid-scroll should not snap the field to the wrong intensity.
    function applyCurrentFieldIntensity(): void {
      (window as any).__glyphField?.setIntensity(fieldLevel.value);
    }
    const onGlyphFieldReady = () => applyCurrentFieldIntensity();
    window.addEventListener("glyphfield:ready", onGlyphFieldReady, { once: true });

    const fieldLevel = { value: 0 };

    function enableMotion(): void {
      cleanupSmoothScroll = initSmoothScroll();

      applyCurrentFieldIntensity();

      // Built paused, then handed to ScrollTrigger as `animation` below:
      // ScrollTrigger drives its progress from scroll, so it must never
      // free-run on its own timeline default (autoplay).
      timeline = gsap.timeline({ paused: true });

      // The fractal layer fades from fully opaque to fully transparent,
      // handing the view over to the document field beneath it.
      if (fractalLayer) {
        timeline.to(
          fractalLayer,
          {
            opacity: 0,
            ease: "none",
            onUpdate: () => {
              fractalOpacity = gsap.getProperty(fractalLayer, "opacity") as number;
              syncFractalActive();
            },
          },
          0,
        );
      }

      // The document field rises from 0 (hidden under the opaque fractal
      // layer) to its normal below-hero resting intensity, in lockstep with
      // the fractal layer's fade, rather than a local copy.
      timeline.to(
        fieldLevel,
        {
          value: RESTING_FIELD_INTENSITY,
          ease: "none",
          onUpdate: applyCurrentFieldIntensity,
        },
        0,
      );

      // The field softens as the hero scrolls rather than snapping into
      // focus the moment the crossfade finishes. Driven through a custom
      // property so the filter string is rebuilt by CSS, not by GSAP parsing
      // and reserialising `filter` on every frame.
      const fieldBlur = { value: 0 };
      timeline.to(
        fieldBlur,
        {
          value: MAX_FIELD_BLUR_PX,
          ease: "none",
          onUpdate: () => {
            fieldLayer.style.setProperty("--glyph-blur", `${fieldBlur.value}px`);
          },
        },
        0,
      );
      // The cue fades out quickly (a fifth the duration of the main
      // crossfade), it has no reason to linger once the user is already
      // well into the 200vh hero journey.
      if (scrollCue) timeline.to(scrollCue, { opacity: 0, ease: "none", duration: 0.2 }, 0);

      trigger = ScrollTrigger.create({
        trigger: heroSection,
        start: "top top",
        // The section is 200vh (100vh visible + 100vh of sticky "hold"
        // room). The crossfade finishes 70% of the way through that extra
        // range, leaving a deliberate still beat on the softened field
        // before the section releases. A function re-evaluates on resize,
        // so this stays correct across viewport size changes.
        end: () => `+=${window.innerHeight * 0.7}`,
        scrub: 0.5,
        animation: timeline,
      });
    }

    function disableMotion(): void {
      trigger?.kill();
      trigger = null;
      timeline?.kill();
      timeline = null;
      cleanupSmoothScroll();
      cleanupSmoothScroll = () => {};
      // Resting state under reduced motion: the fractal layer goes back to
      // fully opaque (gsap.set, no animation) and the document field is held
      // at the same below-hero level the scrub would otherwise settle on
      // (0.14 intensity, 6px blur). Blur is not motion, it is part of the
      // resting composition, so it stays.
      fractalOpacity = 1;
      if (fractalLayer) gsap.set(fractalLayer, { opacity: 1 });
      fieldLevel.value = RESTING_FIELD_INTENSITY;
      applyCurrentFieldIntensity();
      fieldLayer.style.setProperty("--glyph-blur", `${MAX_FIELD_BLUR_PX}px`);
      syncFractalActive();
      if (scrollCue) gsap.set(scrollCue, { opacity: 1 });
    }

    if (prefersReducedMotion()) {
      disableMotion();
    } else {
      enableMotion();
    }

    const unsubscribeReducedMotion = onReducedMotionChange((reduced) => {
      if (reduced) disableMotion();
      else enableMotion();
    });

    // Everything the hero drives is only worth paying for while the hero is
    // actually on screen: the compositor hint on the full-viewport field
    // layer, the fractal worker, and the name's infinite gradient sweep. All
    // used to run for the life of the page, repainting behind content nobody
    // was looking at. The attribute goes on the SECTION, not on one child, so
    // a single flag governs every looping animation the hero owns: the
    // name's gradient sweep and the scroll cue's bounce. Both are decorative
    // and neither is worth a repaint once nobody can see them.
    const heroVisibility = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        fieldLayer.classList.toggle("is-hero-active", visible);
        if (visible) heroSection.removeAttribute("data-offscreen");
        else heroSection.setAttribute("data-offscreen", "");
        sectionVisible = visible;
        syncFractalActive();
      },
      { rootMargin: "10% 0px" },
    );
    heroVisibility.observe(heroSection);

    const teardown = () => {
      disableMotion();
      heroVisibility.disconnect();
      fieldLayer.classList.remove("is-hero-active");
      unsubscribeReducedMotion();
      window.removeEventListener("mandelbrotfield:ready", onFractalReady);
      window.removeEventListener("glyphfield:ready", onGlyphFieldReady);
      window.removeEventListener("astro:before-swap", teardown);
    };
    window.addEventListener("astro:before-swap", teardown, { once: true });
  }
</script>
