---
/**
 * LissajousMark: a parametric knot used as a mark.
 *
 *   x(t) = sin(a*t + delta),  y(t) = sin(b*t)
 *
 * With integer a and b the curve is closed, which is what makes it usable as a
 * mark rather than a scribble: the path returns exactly to its start, so it
 * strokes as one continuous line with no join.
 *
 * It is the third sampling of the same idea the rest of the site is built on.
 * The glyph field evaluates a summed sinusoid per cell per frame, ProjectArt
 * contours one over an area, and this plots one against itself.
 *
 * DENSITY IS THE POINT. A single Lissajous curve is a thin figure that reads as
 * an outline. Drawing several copies with the phase `delta` advanced slightly
 * each time produces the interference lattice a harmonograph makes: the curves
 * cross each other at every phase offset and the overlaps read as depth. Layer
 * count is the whole difference between "a line" and "an object".
 *
 * The layers also carry a colour ramp, deep moss at the back through to hot
 * phosphor at the front, so the stack has a front and a back rather than being
 * a flat tangle.
 *
 * MOTION: the layers draw themselves in sequence as the mark scrolls into
 * view, back to front, so the figure assembles depth-first. `pathLength="1"`
 * normalises every curve so one keyframe drives all of them regardless of
 * their real length, and the per-layer offset is set inline as an
 * `animation-range`, which is inert unless a scroll timeline is actually
 * driving it.
 *
 * Everything is computed at build time. No Math.random, no Date.
 */
/**
 * RATIO SELECTION MATTERS MORE THAN ANY OTHER PARAMETER.
 *
 * a:b must be coprime. If it reduces (2:6 is 1:3, 3:6 is 1:2) the figure
 * collapses from a lattice into a few stacked arcs: a limp shape, not a knot.
 * An earlier version derived a and b arithmetically from taxonomy counts,
 * which looked principled but put four of seven projects on 1:3 or 1:2,
 * because every project happens to carry two or three domains.
 *
 * So the ratio is chosen from a hand-checked table instead. Selection is a
 * hash of the seed, so a given project always gets the same figure and
 * different projects get different ones, without either being left to chance.
 *
 * RATIO AND LAYER COUNT ARE COUPLED, and getting this wrong is what made the
 * first version look like a green blob. The number of line crossings grows
 * with both, so a high-order ratio at a high layer count fills its own dark
 * space in completely. Rendered as a matrix, 3:4 and 5:4 survive ten layers,
 * most pairs stop reading past eight, and 4:5 and 5:7 turn to mush by eight
 * at any size. Those two are gone from the table and the default is seven.
 *
 * If you add a pair here, render it at 128px and at 260px first. A figure
 * whose dark diamonds have closed up is no longer a knot, it is a texture.
 */
/**
 * TRANSPOSES ARE NOT VARIETY. 4:3 is 3:4 rotated a quarter turn and 5:3 is
 * 3:5 rotated, so a table containing both pairs looked like six options while
 * offering four shapes. With the seeds actually in use it put seven of ten
 * marks on what reads as the same figure, and two case studies rendered
 * visually identical. Only one of each transpose pair is kept.
 */
const RATIOS: [number, number][] = [
  [3, 4],
  [5, 4],
  [3, 5],
  [5, 6],
];

/** FNV-1a. `>>> 0` rather than Math.abs so the full 32 bits survive: the high
 *  bits are what the mix below folds down, and Math.abs would discard the sign
 *  bit and skew the result. */
function hash(seed: string): number {
  let h = 2166136261;
  for (let i = 0; i < seed.length; i++) {
    h ^= seed.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

/** Folding the high half into the low half before the modulo. Raw FNV over
 *  short, similar strings ("dropscout", "househub") clusters badly in its low
 *  bits; measured over the site's real seeds this is what puts every ratio in
 *  play instead of leaving one unused. */
const mix = (h: number) => (h ^ (h >>> 16)) >>> 0;

interface Props {
  /** Picks a ratio from RATIOS deterministically. Ignored if a and b are set. */
  seed?: string;
  /** Horizontal frequency. Overrides `seed`. Must be coprime with `b`. */
  a?: number;
  /** Vertical frequency. Overrides `seed`. Must be coprime with `a`. */
  b?: number;
  /** Phase offset of the frontmost curve, in radians. */
  delta?: number;
  /** How many phase-shifted copies to stack. More is denser. */
  layers?: number;
  /** Radians between successive layers. Small values read as a thick, woven
   *  ribbon; large values separate into distinct curves. */
  spread?: number;
  size?: number;
  class?: string;
}

const {
  seed,
  a: aProp,
  b: bProp,
  delta: deltaProp,
  layers = 7,
  spread = 0.1,
  size = 180,
  class: className,
} = Astro.props;

const h = seed ? hash(seed) : 0;
const picked = RATIOS[seed ? mix(h) % RATIOS.length : 0];
const a = aProp ?? picked[0];
const b = bProp ?? picked[1];

// Phase comes from a different slice of the same hash than the ratio does, so
// two seeds that collide on a ratio still land on different orientations. With
// only four shapes available and ten marks on the site, collisions are certain;
// this is what stops them reading as duplicates.
const delta = deltaProp ?? (seed ? ((h >>> 8) % 8) * (Math.PI / 8) : Math.PI / 2);

const VB = 100;
const R = 42; // leaves room for the stroke and its glow inside the viewBox
const CENTER = VB / 2;
const STEPS = 720;

function curve(phase: number): string {
  const pts: string[] = [];
  for (let i = 0; i <= STEPS; i++) {
    const t = (i / STEPS) * Math.PI * 2;
    const x = CENTER + R * Math.sin(a * t + phase);
    const y = CENTER + R * Math.sin(b * t);
    pts.push(`${x.toFixed(2)},${y.toFixed(2)}`);
  }
  return `M${pts.join(" L")}`;
}

// Back to front. The last layer is the brightest and thinnest, so it reads as
// the "true" curve and the rest as its phase history behind it.
const RAMP = [
  "var(--color-aurora-3)",
  "var(--color-aurora-3)",
  "var(--color-accent-dim)",
  "var(--color-accent-dim)",
  "var(--color-accent)",
  "var(--color-accent)",
  "var(--color-bloom-hot)",
];

const paths = Array.from({ length: layers }, (_, i) => {
  const depth = layers === 1 ? 1 : i / (layers - 1); // 0 = back, 1 = front
  return {
    d: curve(delta - (layers - 1 - i) * spread),
    stroke: RAMP[Math.round(depth * (RAMP.length - 1))],
    width: (1.5 - depth * 0.9).toFixed(2),
    opacity: (0.3 + depth * 0.7).toFixed(2),
    // Back layers start drawing first, so the figure builds depth-first.
    range: `entry ${(6 + i * 3).toFixed(0)}% cover ${(34 + i * 4).toFixed(0)}%`,
  };
});
---

<div class:list={["lissajous", className]} aria-hidden="true">
  <svg
    viewBox={`0 0 ${VB} ${VB}`}
    fill="none"
    style={`width:${size}px;height:${size}px`}
    class="lissajous__svg block"
  >
    {
      paths.map((p, i) => (
        <path
          class="lissajous__layer"
          d={p.d}
          stroke={p.stroke}
          stroke-width={p.width}
          stroke-opacity={p.opacity}
          stroke-linecap="round"
          stroke-linejoin="round"
          {...{ pathLength: 1 }}
          style={`animation-range:${p.range};--layer:${i}`}
        />
      ))
    }
  </svg>
</div>

<style>
  .lissajous {
    pointer-events: none;
  }

  /* The bloom. A drop-shadow on the whole figure is one filter for the entire
     stack rather than a glow per path, which is what keeps a dense mark cheap.
     Two radii: a tight one for definition, a wide one for the phosphor halo. */
  .lissajous__svg {
    filter:
      drop-shadow(0 0 1px color-mix(in oklab, var(--color-accent) 55%, transparent))
      drop-shadow(0 0 6px color-mix(in oklab, var(--color-accent-dim) 40%, transparent));
  }

  @supports (animation-timeline: view()) {
    :global(html.js-reveal) .lissajous__layer {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: lissajous-draw linear both;
      animation-timeline: view();
      /* animation-range is set per layer inline, so each curve completes at a
         different scroll position and the stack assembles back to front. */
    }
  }

  @keyframes lissajous-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
