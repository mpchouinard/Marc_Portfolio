---
/**
 * ArtifactList: the paper / repo / notebook / demo row driven by the
 * `artifacts` frontmatter array. Owned by Wave 1 agent B.
 * Renders nothing when `artifacts` is empty.
 */
export interface Props {
  artifacts: Array<{
    type: "paper" | "repo" | "notebook" | "demo" | "poster" | "dataset" | "model" | "slides";
    url: string;
    label: string;
  }>;
}

const { artifacts } = Astro.props;

const TYPE_LABELS: Record<Props["artifacts"][number]["type"], string> = {
  paper: "Paper",
  repo: "Repo",
  notebook: "Notebook",
  demo: "Demo",
  poster: "Poster",
  dataset: "Dataset",
  model: "Model",
  slides: "Slides",
};
---

{
  artifacts.length > 0 && (
    <ul class="flex flex-col divide-y divide-rule rounded-md border border-rule">
      {artifacts.map((a) => (
        <li>
          <a
            href={a.url}
            target="_blank"
            rel="noreferrer noopener"
            class="group flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-raised"
          >
            <span class="flex items-center gap-3">
              <span class="rounded-sm border border-rule px-2 py-0.5 font-mono text-micro uppercase tracking-wide text-muted">
                {TYPE_LABELS[a.type]}
              </span>
              <span class="font-mono text-small text-text transition-colors group-hover:text-accent">
                {a.label}
              </span>
            </span>
            <span
              class="font-mono text-small text-faint transition-colors group-hover:text-accent"
              aria-hidden="true"
            >
              &#8594;
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
