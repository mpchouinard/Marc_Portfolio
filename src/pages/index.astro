---
/**
 * WAVE 0 PLACEHOLDER — Wave 1 agent A/D own the real shell and browse views.
 */
import { getCollection } from "astro:content";
import "../styles/global.css";
import { profile } from "../data/profile";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.period.start.valueOf() - a.data.period.start.valueOf(),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.tagline} />
  </head>
  <body>
    <main>
      <h1>{profile.name}</h1>
      <p>{profile.tagline}</p>
      <ul>
        {work.map((entry) => (
          <li>
            <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
            {" — "}{entry.data.summary}
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
