---
/**
 * Home. Composed by the orchestrator from Wave 1's components:
 *   Hero (agent C) -> selected work (agent D's ProjectCard) -> route to /work/.
 *
 * `bleed` strips <main>'s padded max-width box so the hero can run full-bleed;
 * every section below therefore supplies its own container.
 * `transparentNav` lets the nav sit over the hero until it scrolls.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { profile } from "../data/profile";

const featured = (await getCollection("work"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.period.start.valueOf() - a.data.period.start.valueOf());
---

<Base title={profile.name} description={profile.tagline} transparentNav bleed>
  <Hero />

  {
    featured.length > 0 && (
      <section class="mx-auto w-full max-w-[72rem] px-6 py-24 md:px-10 md:py-32">
        <header
          class="mb-10 flex items-baseline justify-between gap-6 border-b border-rule pb-4"
          data-reveal
        >
          <h2 class="font-mono text-micro uppercase tracking-[0.2em] text-faint">
            Selected work
          </h2>
          <a
            href="/work/"
            class="font-mono text-micro uppercase tracking-[0.2em] text-muted transition-colors hover:text-accent"
          >
            All work →
          </a>
        </header>

        <div class="grid gap-5 md:grid-cols-2" data-reveal-group>
          {featured.map((entry) => <ProjectCard work={entry} />)}
        </div>
      </section>
    )
  }
</Base>
