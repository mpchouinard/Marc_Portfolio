---
/**
 * /work/ — the browse page. Composes:
 *   1. A featured strip (ProjectCard grid) — SSR.
 *   2. The full chronological Timeline — SSR, works with JS off.
 *   3. FacetBrowser, a React island hydrated `client:visible` that lets a
 *      visitor filter the same data by domain / method / year.
 *
 * The page is fully useful with JS disabled: (1) and (2) already render
 * every entry server-side. FacetBrowser is a pure enhancement layered on
 * top, not a requirement for the content to exist.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Timeline from "../../components/Timeline.astro";
import FacetBrowser, { type FacetWorkEntry } from "../../components/FacetBrowser.tsx";

const allEntries = await getCollection("work");

const featured = allEntries.filter((entry) => entry.data.featured);

function formatMonthYear(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
}

// FacetBrowser is a React island: only plain, serialized data may cross the
// boundary. `period.start`/`period.end` are `Date` objects on the collection
// entry, so they're reduced to strings/numbers here, and facet option lists
// are derived here too rather than inside the component.
const facetEntries: FacetWorkEntry[] = allEntries.map((entry: CollectionEntry<"work">) => {
  const d = entry.data;
  return {
    id: entry.id,
    title: d.title,
    summary: d.summary,
    kind: d.kind,
    domains: d.domains,
    methods: d.methods,
    featured: d.featured,
    year: d.period.start.getUTCFullYear(),
    startLabel: formatMonthYear(d.period.start),
    endLabel: d.period.end ? formatMonthYear(d.period.end) : null,
  };
});

const domainOptions = [...new Set(allEntries.flatMap((e) => e.data.domains))].sort();
const methodOptions = [...new Set(allEntries.flatMap((e) => e.data.methods))].sort();
const yearOptions = [...new Set(facetEntries.map((e) => e.year))].sort((a, b) => b - a);
---

<Base
  title="Work"
  description="Research, coursework, and independent builds, plotted on one chronological spine and filterable by domain, method, and year."
>
  <header data-reveal>
    <h1 class="text-display">Work</h1>
    <p class="mt-3 max-w-prose text-lede text-muted">
      Research, coursework, and independent projects share one timeline here rather than three
      separate lists — the point is the trajectory, not the category.
    </p>
  </header>

  {
    featured.length > 0 && (
      <section aria-labelledby="featured-heading" class="mt-16" data-reveal>
        <h2 id="featured-heading" class="font-mono text-micro uppercase tracking-widest text-muted">
          Featured
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2" data-reveal-group>
          {featured.map((entry) => (
            <ProjectCard work={entry} />
          ))}
        </div>
      </section>
    )
  }

  <section aria-labelledby="timeline-heading" class="mt-16" data-reveal>
    <h2 id="timeline-heading" class="font-mono text-micro uppercase tracking-widest text-muted">
      Timeline
    </h2>
    <div class="mt-6">
      <Timeline entries={allEntries} />
    </div>
  </section>

  <section aria-labelledby="browse-heading" class="mt-16" data-reveal>
    <h2 id="browse-heading" class="font-mono text-micro uppercase tracking-widest text-muted">
      Browse by facet
    </h2>
    <div class="mt-6">
      <FacetBrowser
        client:visible
        entries={facetEntries}
        domainOptions={domainOptions}
        methodOptions={methodOptions}
        yearOptions={yearOptions}
      />
    </div>
  </section>
</Base>
