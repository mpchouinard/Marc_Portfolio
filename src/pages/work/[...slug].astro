---
/**
 * Case study template. Section order is fixed by CLAUDE.md and lives in the
 * MDX body as literal `## ` headings.
 *
 * `ResultsTable` and `ArtifactList` are imported and placed by the MDX files
 * themselves, directly under their own `## Experiments` / `## Artifacts`
 * headings, so structured frontmatter renders in place rather than as a
 * detached appendix. Both render nothing when their array is empty.
 */
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import MetaBar from "../../components/MetaBar.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import MathRule from "../../components/MathRule.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <article>
    <header class="mx-auto mb-12 max-w-[68ch]" data-reveal>
      <p class="font-mono text-small uppercase tracking-wide text-muted">
        <a href="/work/" class="transition-colors hover:text-accent">Work</a>
        <span class="text-faint"> / </span>
        <span>{d.kind}</span>
      </p>
      <h1 class="mt-3 text-display text-bright">{d.title}</h1>
      <p class="mt-4 text-lede text-muted">{d.summary}</p>
    </header>

    {/* Banner: a real screenshot when one exists, otherwise the generated
        field art. Runs wider than the 68ch prose measure so each case study
        opens with its own image rather than another wall of text. */}
    <div class="mx-auto mb-12 max-w-[52rem]" data-reveal data-reveal-delay="60">
      {
        d.cover ? (
          <Image
            src={d.cover}
            alt=""
            widths={[640, 1040]}
            sizes="(min-width: 900px) 52rem, 92vw"
            class="aspect-[16/9] w-full border border-rule object-cover"
            loading="eager"
            decoding="async"
          />
        ) : (
          <ProjectArt
            id={entry.id}
            domains={d.domains}
            methods={d.methods}
            stack={d.stack}
            class="aspect-[16/9] w-full border border-rule"
          />
        )
      }
    </div>

    <div class="mx-auto max-w-[68ch]" data-reveal data-reveal-delay="80">
      <MetaBar
        kind={d.kind}
        status={d.status}
        role={d.role}
        affiliation={d.affiliation}
        period={d.period}
        domains={d.domains}
        methods={d.methods}
        stack={d.stack}
      />
    </div>

    {/* Plotted rule rather than a border: the same summed-sinusoid family as
        the glyph field, drifting with the scroll. Seeded off the slug so no
        two case studies draw the same wave. */}
    <div class="mx-auto mt-10 max-w-[68ch]" aria-hidden="true">
      <MathRule seed={entry.id.length * 0.7} height={26} />
    </div>

    <div
      class="mx-auto mt-10 max-w-[68ch] font-body text-body
        [&_h2]:mt-16 [&_h2]:mb-4 [&_h2]:text-title [&_h2:first-of-type]:mt-0
        [&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:text-lede
        [&_p]:mb-5 [&_p]:leading-relaxed [&_p]:text-text
        [&_ul]:mb-5 [&_ul]:ml-5 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:text-text
        [&_ol]:mb-5 [&_ol]:ml-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:text-text
        [&_li]:leading-relaxed [&_li_p]:mb-0
        [&_strong]:font-semibold [&_strong]:text-bright
        [&_em]:italic
        [&_a]:text-accent [&_a]:underline [&_a]:decoration-faint [&_a]:underline-offset-4 [&_a:hover]:decoration-accent
        [&_blockquote]:my-5 [&_blockquote]:border-l-2 [&_blockquote]:border-rule [&_blockquote]:pl-4 [&_blockquote]:text-muted [&_blockquote]:italic
        [&_hr]:my-10 [&_hr]:border-rule
        [&_.katex-display]:my-6"
    >
      <Content />
    </div>
  </article>
</Base>
